# Build the Datasette SQLite + deploy to Vercel on push to main that
# touches data/processed/**. Disabled by default; rename to `publish.yml`
# and add VERCEL_TOKEN repo secret to enable.

name: publish-datasette

on:
  push:
    branches: [main]
    paths:
      - "data/processed/**"
      - "scripts/publish.py"
      - "docs/data-dictionary.md"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          lfs: true

      - name: Set up uv
        uses: astral-sh/setup-uv@v8.1.0
        with:
          enable-cache: true

      - name: Install
        run: uv sync --frozen --extra publish

      - name: Build SQLite
        run: uv run --frozen python -m scripts.publish build

      - name: Deploy to Vercel
        env:
          VERCEL_TOKEN: ${{ secrets.VERCEL_TOKEN }}
        run: |
          uv run --frozen datasette publish vercel \
            data/processed/cast_vote_records.db \
            -m data/processed/metadata.yaml \
            --project cast-vote-records \
            --token "$VERCEL_TOKEN"
