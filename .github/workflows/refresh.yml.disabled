# Cron-driven refresh: fetch → clean → audit → PR on new data.
# Disabled by default. Rename to `refresh.yml` to enable.

name: refresh-data

on:
  schedule:
    - cron: "0 7 1 * *"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          lfs: true

      - name: Set up uv
        uses: astral-sh/setup-uv@v8.1.0
        with:
          enable-cache: true

      - name: Install
        run: uv sync --frozen

      - name: Run pipeline
        run: |
          uv run --frozen python -m scripts.pipeline --fail-on-empty
          uv run --frozen python -m scripts.pipeline reconcile

      - name: Open PR if data changed
        uses: peter-evans/create-pull-request@v6
        with:
          commit-message: "chore(data): scheduled refresh"
          title: "Scheduled CVR refresh"
          body: "Automatic refresh from upstream — review the audit summary in `data/audit/summary.md`."
          branch: data-refresh-${{ github.run_number }}
