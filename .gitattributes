# Cast Vote Record xlsx files are large; store via Git LFS.
data/original/**/*.xlsx filter=lfs diff=lfs merge=lfs -text

# Cleaned wide CSVs run into the tens of MB; LFS keeps diffs small.
data/processed/*.csv filter=lfs diff=lfs merge=lfs -text

# Cluster small-multiples PNG produced by the analysis notebook.
data/processed/*.png filter=lfs diff=lfs merge=lfs -text
data/processed/*.db filter=lfs diff=lfs merge=lfs -text
data/processed/*.parquet filter=lfs diff=lfs merge=lfs -text
